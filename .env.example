# Sanity (sanity.io/manage → project TYRŠ)
NEXT_PUBLIC_SANITY_PROJECT_ID=
# "production" for the live site, "development" for local work with sample content
NEXT_PUBLIC_SANITY_DATASET=development
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01

# Newsletter (Mailchimp → Account → Extras → API keys; Audience → Settings → Audience ID)
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=

# Rental enquiries (resend.com, domain tyrs.art verified)
RESEND_API_KEY=
ENQUIRY_TO=booking@tyrs.art
ENQUIRY_FROM=TYRŠ web <web@tyrs.art>

# Public URL, used for canonical links, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://tyrs.art

# Sanity webhook secret for on-demand revalidation
SANITY_REVALIDATE_SECRET=

# Plausible Analytics (cookieless). Leave empty to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
